# Optional: only needed to preview the site locally before pushing.
# GitHub Pages does not read this file — it builds with its own Jekyll
# version regardless of what's here. See README.md for local setup.
#
# This uses plain "jekyll" rather than the "github-pages" gem: github-pages
# pins the exact version GitHub's servers run, but pulls in a lot of extra
# gems (nokogiri, racc, http_parser.rb) that need a C compiler and Ruby's
# native headers to install. Plain jekyll avoids nearly all of that and is
# enough to preview posts locally. If a page ever renders differently
# locally than on GitHub Pages, that's the trade-off.
source "https://rubygems.org"
gem "jekyll", "~> 4.1"
gem "webrick"   # required by `jekyll serve` on Ruby 3+, no longer in the standard library
